{
  "name": "conveyor-v2",
  "version": "0.2.0",
  "description": "A GitHub-native autonomous software delivery orchestrator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abaniumbay/conveyor.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit",
    "docs:tasks": "bun run scripts/generate-task-docs.ts",
    "docs:cli": "bun run scripts/generate-cli-docs.ts",
    "build": "bun run scripts/build.ts",
    "release": "bun run scripts/release.ts",
    "smoke": "bun run scripts/smoke-test.ts --dist dist",
    "deploy:when-idle": "bun run scripts/deploy-when-idle.ts",
    "start": "bun run src/cli.ts serve"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
